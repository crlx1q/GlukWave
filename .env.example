NODE_ENV=development
HOST=127.0.0.1
PORT=4000
APP_URL=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=0
DB_DRIVER=sqlite
DATA_DIR=var
MONGODB_URI=
MONGODB_DATABASE=glukwave
MEDIA_STORAGE=local
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Generate with npm run keys. Keep stable when switching databases.
TOKEN_ENCRYPTION_KEY=
# Comma-separated emails. Production admin requires verified email.
ADMIN_EMAILS=
REQUIRE_EMAIL_VERIFICATION=false
SMTP_URL=
MAIL_FROM=GlukWave <noreply@wave.gluk.tech>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact registered callbacks. OAUTH_BASE_URL defaults to APP_URL; use the URL of this backend.
OAUTH_BASE_URL=
GOOGLE_REDIRECT_URI=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SOUNDCLOUD_PUBLIC_SEARCH=true
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# OAuth server headless adapter; disable if Discord no longer accepts the scope/transport.
DISCORD_HEADLESS_ENABLED=true
# Optional uploaded Discord Rich Presence asset key; otherwise public /brand/logo.png.
DISCORD_LOGO_ASSET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gluk.tech
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_UNBOUND_PRICE_ID=
UPLOAD_LIMIT_MB=256
LAN_DISCOVERY=false
LAN_DISCOVERY_PORT=4001
# Country-only local IP database; bundled data can be updated with npm run geoip:update.
GEOIP_DATA_DIR=apps/server/data/geoip
# Actual verified downloadable builds and releases.json manifest, outside the web bundle.
RELEASES_DIR=outputs
# Terminal output: studio / compact / json; production defaults to structured JSON.
CONSOLE_STYLE=studio

# Independent server-side metadata/audio adapters (no user API setup)
# Deployment: npm run audio:setup; readiness: npm run audio:setup -- --check
EXTRACTORS_ENABLED=true
EXTRACTOR_PYTHON=
SPOTDL_PYTHON=
EXTRACTOR_DENO=
EXTRACTOR_CONCURRENCY=1
EXTRACTOR_TIMEOUT_MS=45000
EXTRACTOR_CACHE_MB=512
